# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBAPP_URL=          # Public URL of the webapp, e.g. https://your-app.up.railway.app
TELEGRAM_WEBHOOK_SECRET=      # Random string; verifies incoming webhook requests are from Telegram

# Database
DATABASE_URL=                 # Railway provides this, e.g. postgresql://user:pass@host:port/db

# App
ADMIN_TELEGRAM_IDS=           # Comma-separated Telegram user IDs for admin role, e.g. 123456,789012
SECRET_KEY=                   # For HMAC/session use
ENVIRONMENT=development       # development | production
