# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBAPP_URL=
TELEGRAM_WEBHOOK_SECRET=

# Database
DATABASE_URL=

# App
ADMIN_TELEGRAM_IDS=
# Portfolio-specific admins; ADMIN_TELEGRAM_IDS remains the Social fallback.
SOCIAL_ADMIN_TELEGRAM_IDS=
WELFARE_ADMIN_TELEGRAM_IDS=
SECRET_KEY=
ENVIRONMENT=production

# Calendar iCalendar feed (optional; blank means no URL token)
CALENDAR_FEED_TOKEN=

# Resend (required only to send emails)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
WELFARE_RESEND_CC_EMAIL=rh.social.e@u.nus.edu
APP_TIMEZONE=Asia/Kuala_Lumpur
COLLECTION_REMINDER_HOUR=8

# Optional Google Forms JSON override. Normally edit config/google_forms.json instead.
GOOGLE_FORM_CONFIGS={}

# Telegram id to send finished event/initiative announcements to (a relay bot
# that posts into the announcement channel). Leave blank to disable.
ANNOUNCEMENT_TELEGRAM_ID=

# Grading stays off until explicitly enabled.
GRADING_ENABLED=false
GRADING_REMIND_ADMINS=true
# disabled | live
GOOGLE_DRIVE_MODE=disabled
GOOGLE_SERVICE_ACCOUNT_FILE=
# Alternative to a file: JSON secret in your hosting provider, never in Git.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_PARENT_FOLDER_ID=
# Prefer separate parents with portfolio-specific admin access.
GOOGLE_DRIVE_SOCIAL_PARENT_FOLDER_ID=
GOOGLE_DRIVE_WELFARE_PARENT_FOLDER_ID=
